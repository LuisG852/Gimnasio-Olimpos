DEBUG=True
DATABASE_URL=postgresql://usuario:password@localhost:5432/gimnasio_db

# --- Sesiones (login) ---
# Clave para firmar los tokens de sesión. Generá una propia y única
# para cada instalación (nunca reutilices la de otra computadora).
# En una terminal con Python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Correos automáticos de recordatorio de vencimiento (Brevo) ---
# Se consigue en Brevo -> SMTP & API -> API Keys
BREVO_API_KEY=
# Correo remitente: tiene que estar verificado dentro de tu cuenta de Brevo
# (puede ser un Gmail, no hace falta que sea un dominio propio)
BREVO_REMITENTE_EMAIL=
BREVO_REMITENTE_NOMBRE=Olimpo's Gym
GYM_NOMBRE=Olimpo's Gym
# Días antes del vencimiento en que se manda el aviso
DIAS_AVISO_VENCIMIENTO=3
# URL pública del logo para que se vea en los correos (Gmail bloquea
# imágenes en base64; necesita una URL real, ej. de postimages.org)
GYM_LOGO_URL=

# --- Respaldos automáticos ---
# Carpeta donde se guardan los .sql diarios. Si querés que suban a la nube,
# poné aquí la ruta de una carpeta de Google Drive/OneDrive ya sincronizada,
# ej: C:\Users\TuUsuario\OneDrive\RespaldosGym
# Si se deja vacío, se guardan en backend\backups
BACKUP_DIR=
# Cuántos días de respaldos se conservan antes de borrar los más viejos
BACKUP_DIAS_RETENCION=30
# Ruta a pg_dump.exe (para generar respaldos) y psql.exe (para
# restaurarlos) — vienen juntos en la carpeta bin de tu instalación de
# PostgreSQL, ej: C:\Program Files\PostgreSQL\16\bin\
PG_DUMP_PATH=
PSQL_PATH=
